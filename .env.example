# 복사해서 .env 로 저장한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# ─── 서버 전용 (Vercel 환경 변수에 등록, 앱 번들에 포함되지 않음) ───────────────
# 도서 검색: 하나 이상 필요. 카카오 → 알라딘 → 네이버 순서로 사용합니다.
KAKAO_REST_API_KEY=
ALADIN_TTB_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── 앱 (EXPO_PUBLIC_* 는 앱 번들에 포함되어 공개됩니다) ────────────────────────
# 지원 언어 (쉼표 구분). 2개 이상이면 설정 화면에 언어 선택이 나타납니다. 기본: ko
EXPO_PUBLIC_ENABLED_LOCALES=ko
# 도서 검색 지역: KR(국내 도서, 기본) | GLOBAL(해외 도서 — 향후 사용)
EXPO_PUBLIC_BOOK_REGION=KR
# /api 서버 주소. 비워두면 웹 배포본은 같은 도메인, 로컬 개발·모바일 앱은 배포된 사이트를 사용합니다.
# `npx vercel dev`로 함수까지 로컬에서 돌릴 때: http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=

# Supabase (대시보드 > Project Settings > API) — 비워두면 로컬 게스트 모드
# anon(publishable) 키는 RLS로 보호되므로 앱에 들어가도 안전합니다. service_role/secret 키는 절대 넣지 마세요.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 함께 읽기 지도 범위: KR(한국 지도) | GLOBAL(세계 지도 자리 표시)
EXPO_PUBLIC_MAP_SCOPE=KR
