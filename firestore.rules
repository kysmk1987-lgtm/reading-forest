rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function pad(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Today's date in UTC as YYYY-MM-DD (matches utcDay() in src/features/forest/publicForest.ts).
    function utcDay() {
      return string(request.time.year()) + '-' + pad(request.time.month()) + '-' + pad(request.time.day());
    }

    // Private library sync.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public (shared) forests: anyone can view, only the owner can publish.
    match /forests/{forestId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == forestId;

      // One watering per visitor per forest per (UTC) day: the doc id is fixed to
      // {visitorUid}_{today}, and existing docs can't be overwritten or deleted.
      match /waterings/{wateringId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.visitor == request.auth.uid
          && request.resource.data.day == utcDay()
          && wateringId == request.auth.uid + '_' + utcDay();
        allow update, delete: if false;
      }
    }
  }
}
